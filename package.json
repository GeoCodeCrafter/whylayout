{
  "name": "whylayout",
  "version": "0.1.0",
  "description": "Click an element and get a plain-English explanation of why it looks like that: which rule won, what constrained the size, which margin collapsed, what broke position: fixed.",
  "keywords": [
    "css",
    "devtools",
    "debugging",
    "layout",
    "flexbox",
    "grid",
    "cascade",
    "specificity",
    "bookmarklet",
    "stacking-context"
  ],
  "license": "MIT",
  "author": "OpusDevs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeoCodeCrafter/whylayout.git"
  },
  "bugs": {
    "url": "https://github.com/GeoCodeCrafter/whylayout/issues"
  },
  "homepage": "https://github.com/GeoCodeCrafter/whylayout#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "vite serve demo",
    "test:e2e": "playwright test",
    "demo:build": "vite build",
    "demo:gif": "node scripts/record-gif.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "gifenc": "^1.0.3",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
